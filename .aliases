# Shortcuts
alias ch='history 0 | grep "git commit"'
alias hg='history 0 | grep'

# Listings via eza, keeping the classic names; plain ls where eza is missing
if command -v eza >/dev/null 2>&1; then
    alias ls='eza'
    alias la='eza -lahF --git' # long, all, header row, classify, git status column
    alias tree='eza --tree'
else
    # --color=auto stays clean when piped; -G is the older-BSD fallback
    if ls --color >/dev/null 2>&1; then
        colorflag="--color=auto"
    else
        colorflag="-G"
    fi
    alias ls="command ls ${colorflag}"
    alias la="ls -lahF ${colorflag}"
fi

# File-type colors (bold yellow dirs, blue symlinks, green executables):
# LS_COLORS for eza/Linux ls, LSCOLORS for macOS ls (legend: `man ls`)
export LS_COLORS='di=01;33:ln=34:so=32:pi=33:ex=32:bd=34;46:cd=34;43:su=30;41:sg=30;46:tw=30;42:ow=30;43'
export LSCOLORS='Dxexcxdxcxegedabagacad'

# Quiet eza's metadata columns (white by default, green execute bits, red setuid)
export EZA_COLORS='ur=37:uw=37:ux=32:ue=32:gr=37:gw=37:gx=32:tr=37:tw=37:tx=32:su=31:sf=31:xa=37:sn=0:sb=37:uu=37:un=37:uR=31:gu=37:gn=37:gR=31:hd=4;37:lc=37:lm=37'

# cat with syntax highlighting; -p keeps cat's layout, and piped output stays plain
command -v bat >/dev/null 2>&1 && alias cat='bat -p --paging=never'

# Colored grep output (GREP_OPTIONS is deprecated, hence aliases)
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

# Update everything: Homebrew, casks, npm/uv tools, skills, repos
if [[ "$OSTYPE" == darwin* ]]; then
    alias update_all='brew update;
                      brew upgrade --yes;
                      brew upgrade --cask --force --yes;
                      brew link --overwrite node;
                      brew cleanup;
                      $(brew --prefix)/bin/npm update --global;
                      $(brew --prefix)/bin/uv tool upgrade --all;
                      $(brew --prefix)/bin/npx skills update -g -y;
                      $(brew --prefix)/bin/just -g repos'
else # Linux / WSL: apt instead of Homebrew
    alias update_all='sudo apt update && sudo apt upgrade -y && sudo apt autoremove -y;
                      npm update --global;
                      uv tool upgrade --all;
                      npx skills update -g -y;
                      just -g repos'
fi

# Show/hide hidden files in Finder
# (Cmd+Shift+. toggles this in Finder too)
alias show="defaults write com.apple.finder AppleShowAllFiles -bool true && killall Finder"
alias hide="defaults write com.apple.finder AppleShowAllFiles -bool false && killall Finder"

# To prep before screencasts
alias tut_mode="defaults write com.apple.dock autohide -bool true && killall Dock;
              defaults write com.apple.finder CreateDesktop -bool false && killall Finder;
              defaults write com.apple.menuextra.clock IsAnalog -bool true && killall ControlCenter;
              osascript -e 'tell application \"Finder\" to empty the trash' 2>/dev/null;
              rm -rf ~/Downloads/*(N)"
alias reg_mode='defaults write com.apple.dock autohide -bool false && killall Dock;
              defaults write com.apple.finder CreateDesktop -bool true && killall Finder;
              defaults write com.apple.menuextra.clock IsAnalog -bool false && killall ControlCenter;'

alias clean="osascript -e 'tell application \"Finder\" to empty the trash' 2>/dev/null;
            rm -rf ~/Downloads/*(N)"

# open <path>: macOS has it; WSL hands the path to Windows (Explorer for
# folders, the default app for files), desktop Linux uses xdg-open
if ! command -v open >/dev/null 2>&1; then
  open() {
    if command -v xdg-open >/dev/null 2>&1; then xdg-open "${1:-.}"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$(wslpath -w "${1:-.}")"
    else echo "open: nothing to open with on this machine" >&2; return 1; fi
  }
fi

# Copy to clipboard without newlines; pipe into it or give it a command
# (pbcopy on macOS, clip.exe under WSL, xclip on desktop Linux)
c() {
  local -a clip
  if command -v pbcopy >/dev/null 2>&1; then clip=(pbcopy)
  elif command -v clip.exe >/dev/null 2>&1; then clip=(clip.exe)
  else clip=(xclip -selection clipboard); fi
  if [[ $# -eq 0 ]]; then
    # piped input
    tr -d '\n' | "${clip[@]}"
  else
    # run the command
    "$@" | tr -d '\n' | "${clip[@]}"
  fi
}