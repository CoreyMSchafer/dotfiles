# Shortcuts
alias ch='history 0 | grep "git commit"'
alias hg='history 0 | grep'

# Listings: eza (modern ls) when installed, keeping the classic command names
# for muscle memory and tutorials; plain ls otherwise (servers, fresh boxes)
if command -v eza >/dev/null 2>&1; then
    alias ls='eza'
    alias la='eza -lahF --git' # long, all, header row, classify, git status column
    alias tree='eza --tree'
else
    # `--color=auto` colorizes a terminal but stays clean when piped; modern
    # macOS ls accepts it too, so the -G fallback only matters on older systems
    if ls --color >/dev/null 2>&1; then
        colorflag="--color=auto"
    else
        colorflag="-G"
    fi
    alias ls="command ls ${colorflag}"
    alias la="ls -lahF ${colorflag}"
fi

# File-type colors: bold yellow dirs, blue symlinks, green executables.
# LS_COLORS is the GNU syntax (what eza and Linux ls read); LSCOLORS is the
# BSD equivalent for plain macOS ls (legend: `man ls`, LSCOLORS section).
export LS_COLORS='di=01;33:ln=34:so=32:pi=33:ex=32:bd=34;46:cd=34;43:su=30;41:sg=30;46:tw=30;42:ow=30;43'
export LSCOLORS='Dxexcxdxcxegedabagacad'

# cat with syntax highlighting: -p keeps cat's plain layout, and bat drops
# the colors automatically when piped, so scripts and redirects are unaffected
command -v bat >/dev/null 2>&1 && alias cat='bat -p --paging=never'

# Always enable colored `grep` output
# Note: `GREP_OPTIONS="--color=auto"` is deprecated, hence the alias usage.
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

# Update/upgrade Homebrew and their installed packages
alias update_all='brew update;
                  brew upgrade --yes;
                  brew upgrade --cask --force --yes;
                  brew link --overwrite node;
                  brew cleanup;
                  $(brew --prefix)/bin/npm update --global;
                  $(brew --prefix)/bin/uv tool upgrade --all;
                  $(brew --prefix)/bin/npx skills update -g -y;
                  $(brew --prefix)/bin/just -g repos'

# Show/hide hidden files in Finder
# As of macOS Sierra (10.12) and later, you can simply press Cmd + Shift + . (period) while in Finder to toggle the visibility of hidden files.
alias show="defaults write com.apple.finder AppleShowAllFiles -bool true && killall Finder"
alias hide="defaults write com.apple.finder AppleShowAllFiles -bool false && killall Finder"

# To prep before screencasts
alias tut_mode="defaults write com.apple.dock autohide -bool true && killall Dock;
              defaults write com.apple.finder CreateDesktop -bool false && killall Finder;
              defaults write com.apple.menuextra.clock IsAnalog -bool true && killall ControlCenter;
              osascript -e 'tell application \"Finder\" to empty the trash' 2>/dev/null;
              rm -rf ~/Downloads/*(N)"
alias reg_mode='defaults write com.apple.dock autohide -bool false && killall Dock;
              defaults write com.apple.finder CreateDesktop -bool true && killall Finder;
              defaults write com.apple.menuextra.clock IsAnalog -bool false && killall ControlCenter;'

alias clean="osascript -e 'tell application \"Finder\" to empty the trash' 2>/dev/null;
            rm -rf ~/Downloads/*(N)"

# Project / tutorial scaffolding lives in the ~/Work monorepo (synced via GitHub).
# proj_init / yt_init — and the `j` global-justfile alias — are defined there and sourced here:
[ -f "$HOME/Work/Tutorial-Template/shell/work.zsh" ] && source "$HOME/Work/Tutorial-Template/shell/work.zsh"

# Copy to clipboard without newlines. Can be piped to or run as a command.
c() {
  if [[ $# -eq 0 ]]; then
    # No arguments, read from stdin (piped input)
    tr -d '\n' | pbcopy
  else
    # Arguments provided, run as command
    "$@" | tr -d '\n' | pbcopy
  fi
}